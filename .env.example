# Booking and enquiry forms POST here. Both the homepage booking form and
# /services/consulting use this one webhook; the payload carries a `source`
# field so they can be routed apart downstream.
#
# With this unset, the forms show an honest error and point the visitor at the
# Cal.com booking button instead. They never fake a success.
NEXT_PUBLIC_N8N_CONSULTING_FORM_WEBHOOK=
